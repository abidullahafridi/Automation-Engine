{
  "extends": "@workspace/tsconfig/node.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "#ui": ["./src/index.ts"],
      "#ui/*": ["./src/*"],
      "@workspace/ui": ["./src/index.ts"],
      "@workspace/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["dist", "node_modules"]
}
