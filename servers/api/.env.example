# Copy to .env and replace every placeholder. Do not commit .env files.
NODE_ENV=<development|test|production>
API_HOST=<bind-host>
API_PORT=<1-65535>
API_REQUEST_TIMEOUT_MS=<1000-120000>
WEB_ORIGIN=<web-origin-url>
LOG_LEVEL=<fatal|error|warn|info|debug|trace|silent>
# Optional; defaults to false and cannot enable automation without runtime adapters.
AUTOMATION_API_ENABLED=<true|false>
# Local-only demo mode. Requires NODE_ENV=development and loopback binding.
# Required in production. Store the real URI only in the environment's secret manager.
MONGODB_URI=<mongodb-connection-uri>
